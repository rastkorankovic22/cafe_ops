# Copy this file to `.env` in the project root (same folder as docker-compose.yml).
# `.env` is gitignored — do not commit real secrets.

POSTGRES_USER=cafeops
POSTGRES_PASSWORD=cafeops
POSTGRES_DB=cafeops
POSTGRES_PORT=5433

# For Spring (later)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cafeops