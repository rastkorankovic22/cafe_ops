# Copy this file to `.env` in the project root (same folder as docker-compose.yml).
# `.env` is gitignored — do not commit real secrets.

POSTGRES_USER=cafeops
POSTGRES_PASSWORD=cafeops
POSTGRES_DB=cafeops
POSTGRES_PORT=5433

# Spring (optional — application.yml has the same defaults for local dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cafeops
SPRING_DATASOURCE_USERNAME=cafeops
SPRING_DATASOURCE_PASSWORD=cafeops
JWT_SECRET=local-dev-secret-key-at-least-32-characters